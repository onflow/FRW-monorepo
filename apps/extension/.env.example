### .env.dev

# Google drive
GD_BACKUP_NAME=""
GD_FOLDER=""
GD_AES_KEY=""
GD_IV=""
GOOGLE_API=""

# Google Drive backup (off unless the manifest OAuth client is outside GCP project 556216024625)
GOOGLE_DRIVE_BACKUP_ENABLED="false"

# Manifest
OAUTH2_CLIENT_ID=""
OAUTH2_SCOPES=""
WC_PROJECTID=""
MANIFEST_KEY=""

# Development
DEV_PASSWORD=""
MIXPANEL_TOKEN=""

# API URLs (optional - defaults in src/shared/constant/hosts.ts)
API_GO_SERVER_URL="https://api.wallet.flow.com"
API_BASE_URL="https://web.api.wallet.flow.com"
FUNCTIONS_URL="https://functions.wallet.flow.com"
SCANNER_URL="https://scanner.wallet.flow.com"
LINK_URL="https://link.wallet.flow.com"

# External URLs
TERMS_OF_SERVICE_URL="https://wallet.flow.com/terms-of-service"
PRIVACY_POLICY_URL="https://wallet.flow.com/privacy-policy"

# Scripts public key
SCRIPTS_PUBLIC_KEY=""

